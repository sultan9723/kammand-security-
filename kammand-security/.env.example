# Public, browser-readable booking URL. Must be a valid Calendly scheduling URL.
NEXT_PUBLIC_CALENDLY_URL=

# Public analytics provider selector. Defaults to disabled until a provider is approved.
NEXT_PUBLIC_ANALYTICS_PROVIDER=disabled

# Public canonical production origin. Required for production metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=

# Contact delivery. Use "development" locally or "resend" in production when configured.
CONTACT_DELIVERY_PROVIDER=development

# Server-only delivery configuration. Do not expose these as NEXT_PUBLIC values.
CONTACT_RECIPIENT=
CONTACT_FROM=
RESEND_API_KEY=

# Placeholder for a future persistent rate-limit provider, such as managed Redis.
CONTACT_RATE_LIMIT_PROVIDER=development

# Planned future monitoring configuration. Do not expose monitoring credentials publicly.
MONITORING_PROVIDER=
MONITORING_DSN=

